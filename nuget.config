<?xml version="1.0" encoding="utf-8"?>
<!--
  Packages come from nuget.org only. The clear element keeps the feeds of the machine and of any folder above the
  repository out of the restore, so every checkout and CI restore the same packages (code-guidelines 9).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
