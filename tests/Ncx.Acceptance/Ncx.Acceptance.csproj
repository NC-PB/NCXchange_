<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The acceptance tests: the example files of the specification end to end, the rules of the repository itself
    (dependency diagram, packages, fixtures), and the tests of Ncx.Analytics, Ncx.Plugins and Ncx.Cli until those
    have a test project of their own (implementation 00-method 4).
  -->

  <Import Project="../Fixtures.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The fixtures of this project that are no example of the specification, the job manifest of the Nakamura pair
    (implementation 16, P6-01), embedded under their path from the repository root as the examples are
    (tests/README.md).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*.toml" LogicalName="tests/Ncx.Acceptance/Fixtures/%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ncx.Analytics/Ncx.Analytics.csproj" />
    <ProjectReference Include="../../src/Ncx.Plugins/Ncx.Plugins.csproj" />
    <ProjectReference Include="../../src/Ncx.Cli/Ncx.Cli.csproj" />
  </ItemGroup>

  <!--
    The plugins the tests of Ncx.Plugins load (implementation 17, P7-01): each project of Plugins/TestPlugins/ builds
    one plugin DLL, which is built before this project, never referenced, and copied into TestPlugins/ of the output
    folder, where the tests load it from through the plugin loader into a context of its own (D106). Their sources
    are no part of this project. The folder is not called plugins/, so that no command a test runs in the output
    folder loads them.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Plugins/TestPlugins/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Plugins/TestPlugins/ShopRules/ShopRules.csproj" ReferenceOutputAssembly="false"
                      OutputItemType="NcxTestPlugin" />
    <ProjectReference Include="Plugins/TestPlugins/FaultyRules/FaultyRules.csproj" ReferenceOutputAssembly="false"
                      OutputItemType="NcxTestPlugin" />
  </ItemGroup>

  <Target Name="CopyNcxTestPlugins" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="@(NcxTestPlugin)" DestinationFolder="$(OutDir)TestPlugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
