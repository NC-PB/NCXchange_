<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the Z writer sample, run with the tests of the solution (implementation 17, P7-02). They run the
    writer without ncx, so Ncx.Plugins and what it brings are referenced and copied here.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ZOnItsOwnLine.csproj" />
    <ProjectReference Include="../../../../src/Ncx.Plugins/Ncx.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Ncx.Config" />
    <Using Include="Ncx.Core.Machine" />
    <Using Include="Ncx.Core.Model" />
    <Using Include="Ncx.Core.Parsing" />
    <Using Include="Ncx.Core.VirtualMachine" />
    <Using Include="Ncx.Core.VirtualMachine.Events" />
  </ItemGroup>

</Project>
