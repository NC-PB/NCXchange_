<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The block writer that puts Z on a line of its own (code-guidelines 11; implementation 17, P7-02), the second
    example of templates/ncx-plugin as a finished plugin. It references Ncx.Plugins alone, which brings Ncx.Core,
    Ncx.Readers and Ncx.Compilers with it (D106), and copies none of them next to the plugin, because ncx gives a plugin
    its own when it loads it (architecture 9).
  -->

  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefaultItemExcludes>$(DefaultItemExcludes);ZOnItsOwnLine.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Ncx.Plugins/Ncx.Plugins.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The namespaces of ncx for every .cs file, so that none of them needs a using line (code-guidelines 11). -->
  <ItemGroup>
    <Using Include="Ncx.Compilers" />
    <Using Include="Ncx.Core.VirtualMachine.Events" />
    <Using Include="Ncx.Core.VirtualMachine.State" />
  </ItemGroup>

</Project>
