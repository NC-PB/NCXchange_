<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The coolant clutch rule of code-guidelines 11 as a finished plugin (implementation 17, P7-02): the plugin that ncx
    plugin new makes from templates/ncx-plugin, built with the repository. It references Ncx.Plugins alone, which
    brings Ncx.Core, Ncx.Readers and Ncx.Compilers with it (D106), and copies none of them next to the plugin, because
    ncx gives a plugin its own when it loads it (architecture 9).
  -->

  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefaultItemExcludes>$(DefaultItemExcludes);CoolantClutch.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Ncx.Plugins/Ncx.Plugins.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The namespaces of ncx for every .cs file, so that none of them needs a using line (code-guidelines 11). -->
  <ItemGroup>
    <Using Include="Ncx.Core.Expander" />
    <Using Include="Ncx.Core.Model" />
  </ItemGroup>

</Project>
