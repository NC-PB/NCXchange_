<Project>

  <!--
    The settings of code-guidelines 9 for every project of the repository (implementation 00-method 3). CA1305 is
    an error through .editorconfig. This file imports nothing from above the repository root: worktrees of this
    repository live under .worktrees/ and build with their own copy of it only.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      TODO(question): while InvariantGlobalization is true the .NET analyzers do not report CA1305 at all (checked
      2026-09-13: decimal.Parse(text) passes, and is an error with InvariantGlobalization false), so the two settings
      of code-guidelines 3.4 and 9 cancel out. Both are kept as written until the maintainer decides (D108);
      meanwhile the culture rule rests on review.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
